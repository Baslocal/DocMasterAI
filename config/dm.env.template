# DocMaster — Runtime Environment Configuration
# Location: /opt/docmaster/config/dm.env
# Permissions: 600 (owner read/write only — dmuser:docgroup)
# Sourced by: all dm-*.service systemd units via EnvironmentFile=
#
# STRICT RULE: Never hardcode credentials anywhere. All secrets live here.
# Copy this template to dm.env and fill in ALL values before first boot.

# ── Application Identity ──────────────────────────────────────────────────
DM_VERSION=1.0.0
DM_BUILD=
DM_NODE=docmaster-node-01
INSTALL_PATH=/opt/docmaster

# ── API Server (dm-core) ──────────────────────────────────────────────────
DM_HOST=0.0.0.0
DM_PORT=8443
DM_WORKERS=1

# ── Database (PostgreSQL 16 — localhost only) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dm_vault
DB_USER=dm_app
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

# ── Redis (localhost only) ────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT
REDIS_DB=0

# ── Ollama (localhost only — NEVER expose to network) ─────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODELS=/opt/docmaster/models
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1

# ── LLM Models ────────────────────────────────────────────────────────────
LLM_PRIMARY_MODEL=llama3.1:8b-q4_K_M
EMBEDDING_MODEL=nomic-embed-text

# ── JWT / Security ────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/opt/docmaster/config/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/opt/docmaster/config/jwt_public.pem
JWT_ALGORITHM=RS256
SESSION_TIMEOUT=3600
BCRYPT_COST=12

# ── Paths ─────────────────────────────────────────────────────────────────
SCHEMAS_PATH=/opt/docmaster/config/schemas
CLASSIFIER_MODEL_PATH=/opt/docmaster/models/classifier/doc_classifier_v1.onnx
VAULT_PATH=/opt/docmaster/vault
TMP_PATH=/opt/docmaster/tmp
LOG_PATH=/opt/docmaster/logs

# ── OCR Worker (dm-flux) ──────────────────────────────────────────────────
# Number of parallel OCR workers (1 for CPU-only, 2 for GPU with ≥24GB VRAM)
DM_WORKER_COUNT=1

# ── Backup ────────────────────────────────────────────────────────────────
# GPG passphrase derived from hardware at runtime — DO NOT set here
# BACKUP_GPG_PASSPHRASE is computed by dm-vault.service from hardware fingerprint

# ── PaddleOCR (disable all auto-downloads — air-gap requirement) ──────────
PADDLE_PDX_CACHE_HOME=/opt/docmaster/models/paddleocr
# Disable paddle telemetry
FLAGS_call_stack_level=0

# ── SMTP (optional — for notifications) ───────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Set via dm_vault.system_config with is_encrypted=true
SMTP_PASSWORD=

# ── License ───────────────────────────────────────────────────────────────
LICENSE_KEY_PATH=/opt/docmaster/config/license.key
